# Local: copy to .streamlit/secrets.toml (git-ignored).
# Streamlit Community Cloud: paste into App settings -> Secrets.
# Neither key is required to start the app.

APP_ENV = "development"

OPENROUTER_API_KEY = ""
OPENROUTER_MODEL = "openai/gpt-4o-mini"
OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"

VIRUSTOTAL_API_KEY = ""
