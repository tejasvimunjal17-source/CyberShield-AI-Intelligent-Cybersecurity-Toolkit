# Copy to .env for local runs. NEVER commit the real .env file.
# Neither key is required to start the app; QR tools, URL heuristics
# and file hashing work without them.

APP_ENV=development

# CyberGuide AI + optional AI explanations (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Threat intelligence lookups (VirusTotal)
VIRUSTOTAL_API_KEY=
